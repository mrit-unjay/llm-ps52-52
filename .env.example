# Copy this file to .env and put your real key in .env (never in this file).
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Main model and a backup used automatically when the main one is busy.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Optional: full path to tesseract.exe if it is not found automatically.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
